{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "sunsynk-home-assistant",
      "tag-prefix": "v",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/sunsynk/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "pyproject.toml"
        }
      ]
    }
  }
}
